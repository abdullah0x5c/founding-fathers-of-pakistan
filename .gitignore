# Source scans — 1.7 GB. These live on archive.org, not in git.
# Anchored to the repo root: without the leading slash this would also match
# web/content/, which holds the site's TypeScript catalogue data, not scans.
/content/

# Design canvas export
design-guide/*.zip

# Bulk-upload working files (scripts/generate-ia-upload.py). Both hold absolute
# local file paths and are meaningless on another machine; content/ia-map.json
# is the durable, portable result and is tracked normally.
web/scripts/ia-uploads.csv
web/scripts/ia-plan.json

# Node
node_modules/
.next/
out/
.env*.local
.vercel
*.tsbuildinfo
next-env.d.ts

# OS
.DS_Store

# Claude Code session/worktree state — not project content
.claude/
